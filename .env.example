# Copy to .env and fill in locally. Never commit real values.

# Runtime
APP_ENV=local
LOG_LEVEL=INFO

# API auth (bearer token for FastAPI)
ACQUISCOUT_API_KEY=change-me-local-only

# Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acquiscout
REDIS_URL=redis://localhost:6379/0

# Search / scrape providers
TAVILY_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=

# Reasoning / judgment models
GROQ_API_KEY=
GEMINI_API_KEY=

# Free-tier budget guards
DISCOVERY_CACHE_TTL_HOURS=168
SCRAPE_FALLBACK_TO_FIRECRAWL=false   # flip to true only when Jina fails
JINA_MIN_CHARS=400
MAX_TAVILY_CREDITS_PER_RUN=50
MAX_FIRECRAWL_CREDITS_PER_RUN=10
GROQ_DAILY_TOKEN_BUDGET=100000
GEMINI_DAILY_REQUEST_BUDGET=1000
